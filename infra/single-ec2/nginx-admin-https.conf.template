# Separate TLS listener for the admin screen. Kept off the main :443 site entirely — see
# the hard 404s for /admin, /admin/, and /api/v1/admin/ in nginx-app-locations.conf. This
# port should only ever be reachable from an operator's fixed IP; restrict it at the EC2
# security group (never 0.0.0.0/0 or ::/0), in addition to the app-level ADMIN_ALLOWED_IPS
# check and the ADMIN role + MFA gate.
server {
    listen 19091 ssl;
    http2 on;
    server_name ${DOMAIN_NAME};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 21m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(),microphone=(),geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Cache-Control "no-store" always;

    location = /healthz {
        access_log off;
        return 200 "ok";
        default_type text/plain;
    }

    # Admin API only. Points at the backend's isolated internal admin connector, not the
    # normal one, so an admin JWT alone is never enough to reach it without also arriving
    # through this listener.
    location ^~ /api/v1/admin/ {
        proxy_pass http://${BACKEND_ADMIN};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 19091;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 75s;
    }

    # The admin login screen still needs the normal auth endpoints to sign in and to
    # refresh its session before MFA is verified.
    location ~ ^/api/v1/auth/(login|refresh|logout) {
        limit_req zone=auth_limit burst=5 nodelay;
        proxy_pass http://${BACKEND_NORMAL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 19091;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-Id $request_id;
    }

    location /assets/ { try_files $uri =404; expires max; }
    location = /index.html { expires -1; }
    location / { try_files $uri $uri/ /index.html; }
}
